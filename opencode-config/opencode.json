{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://host.containers.internal:1234/v1"
      },
      "models": {
        "google/gemma-3n-e4b": {
          "name": "Gemma 3n-e4b (local)"
        },
        "codestral-22b-v0.1": {
          "name": "Codestral 22b v0.1 (local)"
        },
        "qwen/qwen3.6": {
          "name": "Qwen 3.6 (local)"
        }
      }
    },
    "lmstudio-schleppx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (schleppx)",
      "options": {
        "baseURL": "http://schleppx:1234/v1"
      },
      "models": {
        "qwen/qwen3.6-27b": {
          "name": "Qwen 3.6 27b(schleppx)"
        }
      }
    }
  },
  "mcp": {
    "twcmcp": {
      "type": "remote",
      "url": "http://host.containers.internal:8000",
      "enabled": false
    },
     "cameo": {
      "type": "local",
      "enabled": false,
      "command": ["/workspace/cameo-mcp-bridge/mcp-server/.venv/bin/python","-m", "cameo_mcp.server"],
      "env": {
        "CAMEO_BRIDGE_HOST": "host.containers.internal",
        "CAMEO_BRIDGE_PORT": "18740"
      }
    },
    "saf-ontology": {
      "type": "local",
      "command": ["/workspace/SAF-Specification/tools/saf-mcp-server/.venv/bin/python", "-m", "saf_server.server"],
      "environment": {
        "SAF_DATA_DIR": "/workspace/SAF-Specification/src/_data",
        "PYTHONPATH": "/workspace/SAF-Specification/tools/saf-mcp-server"
      },
      "enabled": false
    },
    "saf-ontology-remote": {
      "type": "remote",
      "url": "http://host.containers.internal:8001/sse",
      "enabled": true
    }
   },
   "disabled_providers": [
    "lmstudio",
    "lmstudio-schleppx"
  ]
}